{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentesmodernas",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_FILES",
      "bucket_name": "mentesmodernas-private"
    }
  ],
  "observability": {
    "enabled": true
  }
}
