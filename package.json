    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "firebase-admin": "^14.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.130.0"
  }
