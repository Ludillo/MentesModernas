{
  "name": "mentesmodernas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/configure.mjs",
    "check": "wrangler types && tsc -b && tsc -p tsconfig.server.json",
